<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="WidgetDeliveryChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:background">@drawable/widget_chip_delivery</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/widget_delivery_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="WidgetStorageChip" parent="WidgetDeliveryChip">
        <item name="android:background">@drawable/widget_chip_storage</item>
        <item name="android:textColor">@color/widget_storage_text</item>
    </style>
    <style name="WidgetDateGap">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textColor">@color/widget_separator</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="WidgetVerticalDivider" parent="WidgetDateGap">
        <item name="android:layout_width">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">0sp</item>
    </style>
    <!-- Base application theme. -->
    <style name="Base.Theme.BusinessDayCalculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
    </style>

    <style name="Theme.BusinessDayCalculator" parent="Base.Theme.BusinessDayCalculator" />
</resources>
