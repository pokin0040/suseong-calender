<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView android:layout_width="20dp" android:layout_height="wrap_content" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="배달일"
            android:textColor="@color/chip_green_text"
            android:textStyle="bold"
            android:textSize="10sp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:visibility="invisible"
            android:paddingLeft="1dp"
            android:paddingRight="1dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="보관일"
                android:textColor="@color/chip_blue_text"
                android:textStyle="bold"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Normal (일반) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="일반"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start">

            <TextView
                android:id="@+id/chipNormalDel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_green"
                android:textColor="@color/chip_green_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/colonNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textColor="@color/text_secondary"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:textSize="8.5sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center">

            <TextView
                android:id="@+id/chipNormalSto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_blue"
                android:textColor="@color/chip_blue_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Court (법원) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="법원"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start">

            <TextView
                android:id="@+id/chipCourtDel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_green"
                android:textColor="@color/chip_green_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/colonCourt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textColor="@color/text_secondary"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:textSize="8.5sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center">

            <TextView
                android:id="@+id/chipCourtSto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_blue"
                android:textColor="@color/chip_blue_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Certified (내용) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="내용"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start">

            <TextView
                android:id="@+id/chipCertDel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_green"
                android:textColor="@color/chip_green_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/colonCert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textColor="@color/text_secondary"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:textSize="8.5sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center">

            <TextView
                android:id="@+id/chipCertSto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_blue"
                android:textColor="@color/chip_blue_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Contract (계약) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:text="계약"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/text_main" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start">

            <TextView
                android:id="@+id/chipContractDel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_green"
                android:textColor="@color/chip_green_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/colonContract"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=":"
            android:textColor="@color/text_secondary"
            android:paddingLeft="1dp"
            android:paddingRight="1dp"
            android:textSize="8.5sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:gravity="center">

            <TextView
                android:id="@+id/chipContractSto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_blue"
                android:textColor="@color/chip_blue_text"
                android:textSize="9sp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>